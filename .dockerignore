# 后端镜像构建上下文（仓库根目录）
.git
.gitignore
.github
.vscode
.idea

# Python 本地环境与缓存
.venv
venv
**/__pycache__
**/*.py[cod]

# 环境变量（镜像内通过 docker-compose 注入）
.env
.env.*
!.env.example

# 数据库目录（目录挂载，不进镜像）
postgres_data

# 前端目录（由 web/ 独立镜像构建，避免后端上下文过大）
web

# 部署编排文件本身
docker-compose.yml
Dockerfile
nginx
docs
openwiki/

*.md
!README.md
