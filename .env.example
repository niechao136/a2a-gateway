# ============ 环境变量样例 ============
# 应用通过 python-dotenv 的 load_dotenv() 加载环境变量，
# 优先级：真实环境变量 > 文件（文件只填补缺失项，不会覆盖已存在的变量）。
# 使用方式：
#
# 1) docker compose 部署（推荐）：本文件会被 compose 读取用于 ${VAR} 变量替换，
#    再由 docker-compose.yml 的 environment 注入容器。
#
# 2) 本机直接运行后端：
#    a. 直接注入环境变量（Linux/macOS: export XXX=...  |  Windows: $env:XXX="..."）
#    b. 复制本文件为 .env 即可自动加载（从代码目录逐级向上查找，无需额外配置）
#    c. 也可用 DOTENV_PATH 指定文件路径（多个文件用 os.pathsep 分隔）
#       Linux/macOS : export DOTENV_PATH=.env
#       Windows     : $env:DOTENV_PATH=".env"
#
# ============ 数据库 (PostgreSQL) ============
# 组件式配置：应用会自动拼接 DATABASE_URL（asyncpg）与 CHECKPOINT_DB_URL（psycopg）
POSTGRES_USER=a2a
POSTGRES_PASSWORD=a2a_secret
POSTGRES_DB=a2a_gateway
# 本机直接运行后端时用 localhost；docker compose 部署时编排会覆盖为服务名 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 如需连接外部/已有数据库，可直接指定完整连接串（设置后优先于上面的组件配置）
# DATABASE_URL=postgresql+asyncpg://a2a:a2a_secret@localhost:5432/a2a_gateway
# CHECKPOINT_DB_URL=postgresql://a2a:a2a_secret@localhost:5432/a2a_gateway

# ============ 默认 Agent 绑定的 Hermes A2A 目标 ============
HERMES_A2A_URL=http://localhost:8080/
HERMES_A2A_TOKEN=

# ============ LangGraph Agent 的 LLM（OpenAI 兼容端点）============
# 可指向 OpenAI、本地 ollama、或服务器上的兼容服务
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ============ 管理员认证 (JWT) ============
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 管理员初始账号（首次启动时若不存在则自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ============ 应用配置 ============
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端地址（CORS）；本机用 npm run dev 时为 http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# 挂起任务（input-required）：超过该秒数未恢复的挂起在读取时视为失效并清理（默认 86400）
PENDING_A2A_TTL_SECONDS=86400

# ============ 语音服务（onnx-hub）：ASR 识别 / TTS 合成 ============
# 网关代理 onnx-hub 并注入 API Key，前端无需接触真实 Key
# ASR: WS  /ws/asr（16kHz 单声道 int16 PCM 流式识别，中英双语）
# TTS: POST /api/speech/tts（返回 WAV 音频）
ONNX_HUB_BASE_URL=http://43.156.187.79:10100
ONNX_HUB_API_KEY=sk-hub-xxxx
ONNX_HUB_ASR_MODEL=zipformer-streaming-bilingual-zh-en
ONNX_HUB_TTS_MODEL=vits-zh-aishell3

# ============ 告警（可选）============
# 配置后，A2A 调用失败 / Agent 加载失败 / 对话流式失败会 POST 到该 Webhook
# payload: {"level","title","detail"}；未配置时仅写 ERROR 日志
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# ============ 沙箱执行器（Skill 捆绑脚本）============
# backend ↔ sandbox-gate 共享的内部 token（仅 compose 内网，无需对外保密级别，
# 但请勿沿用默认值上生产）。backend 侧 SANDBOX_URL 默认 http://sandbox-gate:8100。
SANDBOX_TOKEN=dev-only-sandbox-token

# ============ Docker 部署 ============
# nginx 统一入口对外暴露的端口（前端 / 后端 / API 全部经此端口访问）
GATEWAY_PORT=10099
# 注意：
# 1) docker compose 部署时，编排会把 POSTGRES_HOST 覆盖为服务名 postgres，
#    数据库不向宿主机暴露端口；此处的 localhost 仅用于本机直连/本地开发。
# 2) 后端容器内访问宿主机服务（如本机 Hermes A2A）请用 host.docker.internal，
#    例如 HERMES_A2A_URL=http://host.docker.internal:8080/
# 3) FRONTEND_ORIGIN 在 compose 中默认取 http://localhost:${GATEWAY_PORT}。
