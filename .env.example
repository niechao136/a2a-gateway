# ============ 数据库 (PostgreSQL) ============
POSTGRES_USER=a2a
POSTGRES_PASSWORD=a2a_secret
POSTGRES_DB=a2a_gateway
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 完整连接串（优先于上面的分段配置）
DATABASE_URL=postgresql+asyncpg://a2a:a2a_secret@localhost:5432/a2a_gateway

# ============ LangGraph Checkpointer ============
# 使用与配置库相同的 PostgreSQL 实例
CHECKPOINT_DB_URL=postgresql://a2a:a2a_secret@localhost:5432/a2a_gateway

# ============ 默认 Agent 绑定的 Hermes A2A 目标 ============
HERMES_A2A_URL=http://localhost:8080/
HERMES_A2A_TOKEN=

# ============ LangGraph Agent 的 LLM（OpenAI 兼容端点）============
# 可指向 OpenAI、本地 ollama、或服务器上的兼容服务
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# ============ 管理员认证 (JWT) ============
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 管理员初始账号（首次启动时若不存在则自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ============ 应用配置 ============
APP_HOST=0.0.0.0
APP_PORT=8000
# 前端地址（CORS）
FRONTEND_ORIGIN=http://localhost:3000
